rules_version = '2';

// Правила базы для онлайн-голосования agora.
// Вставь этот файл целиком в Firebase -> Firestore Database -> Rules и нажми Publish.
// В строке с isAdmin замени ВСТАВЬ_UID_АДМИНА на свой UID
// (Firebase -> Authentication -> Users -> столбец User UID).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "ВСТАВЬ_UID_АДМИНА";
    }

    function settings() {
      return get(/databases/$(database)/documents/settings/main).data;
    }

    // Статус голосования и опубликованные итоги: читают все, меняет только админ
    match /settings/main {
      allow get: if true;
      allow write: if isAdmin();
    }

    // Голоса: документ называется uid браузера, поэтому второй голос с того же браузера невозможен
    match /votes/{uid} {
      // свой голос видит только сам проголосовавший (и админ)
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // список голосов и подсчёт - только админ; удаление нужно для тестового сброса
      allow list, delete: if isAdmin();
      // голосовать можно один раз, только пока голосование открыто, только за существующего кандидата
      allow create: if request.auth != null
        && request.auth.uid == uid
        && settings().status == "open"
        && request.resource.data.keys().hasOnly(["candidate", "at"])
        && request.resource.data.candidate in [1, 2, 3, 4]
        && request.resource.data.at == request.time;
      // изменить голос нельзя никому
      allow update: if false;
    }
  }
}
